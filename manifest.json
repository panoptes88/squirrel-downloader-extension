{
  "manifest_version": 3,
  "name": "松鼠下载器",
  "description": "嗅探网页中的视频资源（m3u8 / MP4 / MPD），一键发送到「松鼠下载器」NAS 端下载",
  "version": "1.1.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html",
    "default_title": "松鼠下载器"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "webRequest",
    "storage",
    "tabs",
    "cookies",
    "activeTab",
    "unlimitedStorage",
    "declarativeNetRequest",
    "webNavigation"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "host_permissions": [
    "*://*/*",
    "<all_urls>"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "incognito": "split"
}
